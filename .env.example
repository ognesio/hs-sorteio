# Copie para .env.local (desenvolvimento) e configure as mesmas variáveis no Netlify.
# Apenas chaves PÚBLICAS aqui. A service_role e os tokens do WhatsApp ficam nos secrets das Edge Functions.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable
# Opcional — Cloudflare Turnstile (anti-robô). Se usar, configure TURNSTILE_SECRET_KEY na Edge Function.
VITE_TURNSTILE_SITE_KEY=
